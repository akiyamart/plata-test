HTTP_ADDR=:8080
DATABASE_URL=postgres://quotes:quotes@localhost:5432/quotes?sslmode=disable
FX_BASE_URL=https://api.exchangerate.dev
EXCHANGERATE_API_KEY=
FX_TIMEOUT_MS=5000
# Per process: with N replicas, set ≈ global_budget / N
FX_RPS=2
FX_BURST=1
FX_RETRY_ATTEMPTS=3
FX_RETRY_BASE_MS=200
MIGRATIONS_DIR=migrations
WORKER_INTERVAL_MS=300
JOB_TIMEOUT_MS=20000
# Keep PROCESSING_LEASE_MS > JOB_TIMEOUT_MS (+ margin)
PROCESSING_LEASE_MS=45000
MAX_ATTEMPTS=3
# Soft limit (TOCTOU); not a hard invariant under concurrent creates
MAX_PENDING=1000
QUOTE_FRESHNESS_MS=30000
STALE_FALLBACK_MS=300000
# Per process: N × DB_MAX_CONNS must fit Postgres max_connections
DB_MAX_CONNS=8
